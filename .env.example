# Simulação padrão; adaptador OpenAI opcional de US08. Copiar para .env é opcional.
# Valores fictícios, exclusivos para desenvolvimento local.
# DATABASE_URL abaixo corresponde ao Compose (também é definida no YAML).
# No caminho nativo, substituir por:
# postgresql+psycopg://portfolio_test:senha_ficticia_teste@127.0.0.1:55432/portfolio_chamados_demo
# Variáveis da sessão prevalecem sobre este arquivo. Não adicionar chaves reais.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://portfolio_user:senha_ficticia@localhost:5432/portfolio_chamados
AI_MODE=simulated
# OpenAI opcional: manter desabilitada até autorizar a avaliação real e o custo.
# AI_MODE=openai exige ambas as variáveis abaixo. Não há modelo padrão.
# OPENAI_API_KEY=chave_ficticia_sem_validade
# OPENAI_MODEL=modelo_a_definir_na_avaliacao
# Groq opcional: manter AI_MODE=simulated nesta etapa, sem chamadas reais.
# AI_MODE=groq exige ambas; modelo deve suportar ferramentas e JSON Schema estrito.
# GROQ_API_KEY=chave_ficticia_sem_validade
# GROQ_MODEL=modelo_a_definir_na_avaliacao
